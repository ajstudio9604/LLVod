# macOS 生成的目录元数据和临时文件
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Xcode 个人设置和窗口状态；保留共享方案与工作区配置
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Xcode 构建目录、派生数据和编译中间文件
build/
DerivedData/
*.hmap
*.moved-aside

# 应用打包、归档、调试符号和运行结果
*.app
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM
*.xcresult

# Swift 交互式开发生成的时间线和工作区
timeline.xctimeline
playground.xcworkspace

# Swift 包管理器的构建缓存；保留 Package.resolved 和共享配置
.build/

# CocoaPods 下载的依赖通过 pod install 恢复
# 保留 Podfile、Podfile.lock、工程文件及共享工作区，便于固定依赖版本和协作
/Pods/

# Carthage 构建产物；保留依赖声明、锁文件和现有源码管理策略
Carthage/Build/

# fastlane 自动生成的报告、截图和测试输出
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# 不忽略本地签名证书、描述文件和钥匙串
# *.p12
# *.pfx
# *.mobileprovision
# *.provisionprofile
# *.keychain
# *.keychain-db

# 编辑器生成的交换文件和备份文件
*.swp
*.swo
*~
